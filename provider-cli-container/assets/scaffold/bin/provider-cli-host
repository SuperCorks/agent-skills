#!/usr/bin/env bash

set -euo pipefail

source_path="${BASH_SOURCE[0]}"
while [[ -h "${source_path}" ]]; do
  source_directory="$(cd -P "$(dirname "${source_path}")" && pwd)"
  source_path="$(readlink "${source_path}")"
  if [[ "${source_path}" != /* ]]; then
    source_path="${source_directory}/${source_path}"
  fi
done

script_directory="$(cd -P "$(dirname "${source_path}")" && pwd)"
workspace="$(cd "${script_directory}/../.." && pwd -P)"
devcontainers_cli_version="0.80.2"
workspace_key="$(printf '%s' "${workspace}" | cksum | awk '{print $1}')"
lock_directory="${TMPDIR:-/tmp}/__COMMAND_NAME__-${workspace_key}.lock"

if [[ ! -f "${workspace}/.devcontainer/devcontainer.json" ]]; then
  echo "Cannot find the __PROJECT_NAME__ provider CLI configuration under ${workspace}." >&2
  exit 1
fi

if ! command -v npx >/dev/null 2>&1; then
  echo "npx is required on the host to start the provider CLI container." >&2
  exit 1
fi

if ! command -v docker >/dev/null 2>&1; then
  echo "Docker is required on the host to start the provider CLI container." >&2
  exit 1
fi

if ! mkdir "${lock_directory}" 2>/dev/null; then
  echo "Another __COMMAND_NAME__ command is already running for ${workspace}." >&2
  exit 1
fi

container_id=""
remove_container_on_exit=false

find_container_id() {
  docker ps \
    --filter "label=devcontainer.local_folder=${workspace}" \
    --format '{{.ID}}' \
    | head -1
}

cleanup() {
  local exit_status=$?
  trap - EXIT HUP INT TERM
  if [[ "${remove_container_on_exit}" == true ]]; then
    if [[ -z "${container_id}" ]]; then
      container_id="$(find_container_id)"
    fi
    if [[ -n "${container_id}" ]]; then
      docker stop "${container_id}" >/dev/null 2>&1 || true
    fi
  fi
  rmdir "${lock_directory}" 2>/dev/null || true
  exit "${exit_status}"
}
trap cleanup EXIT HUP INT TERM

container_id="$(find_container_id)"

if [[ -z "${container_id}" ]]; then
  remove_container_on_exit=true
  if ! npx --yes "@devcontainers/cli@${devcontainers_cli_version}" up \
    --workspace-folder "${workspace}" \
    --remove-existing-container; then
    container_id="$(find_container_id)"
    exit 1
  fi
  container_id="$(find_container_id)"
  if [[ -z "${container_id}" ]]; then
    echo "The provider CLI container did not start." >&2
    exit 1
  fi
fi

npx --yes "@devcontainers/cli@${devcontainers_cli_version}" exec \
  --workspace-folder "${workspace}" \
  __COMMAND_NAME__ "$@"
