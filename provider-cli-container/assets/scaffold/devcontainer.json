{
  "name": "__PROJECT_NAME__ Provider CLI",
  "initializeCommand": "bash .devcontainer/install-host-command.sh",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "runArgs": ["--rm"],
  "shutdownAction": "stopContainer",
  "remoteUser": "${localEnv:DEVCONTAINER_REMOTE_USER:node}",
  "remoteEnv": {
    "PROVIDER_CLI_SECRETS_FILE": "${containerWorkspaceFolder}/.devcontainer/secrets.env",
    "PROVIDER_CLI_WORKSPACE": "${containerWorkspaceFolder}",
    "PATH": "${containerEnv:PATH}:${containerWorkspaceFolder}/.devcontainer/bin"
  },
  "mounts": [
    "source=__CONFIG_VOLUME__,target=/home/node/.config,type=volume"
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh"
}
