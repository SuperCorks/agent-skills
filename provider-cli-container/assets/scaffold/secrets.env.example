# Copy this file to .devcontainer/secrets.env and run:
#   chmod 600 .devcontainer/secrets.env
#
# Keep only providers used by this project. Prefer project-scoped or robot-user
# tokens. Production release credentials normally belong in CI.

VERCEL_TOKEN=
EXPO_TOKEN=
SUPABASE_ACCESS_TOKEN=
POSTHOG_CLI_API_KEY=
POSTHOG_CLI_PROJECT_ID=
POSTHOG_CLI_HOST=
GOOGLE_WORKSPACE_CLI_CLIENT_ID=
GOOGLE_WORKSPACE_CLI_CLIENT_SECRET=
GH_TOKEN=
