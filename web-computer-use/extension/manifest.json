{
  "manifest_version": 3,
  "name": "Web Computer Use",
  "version": "1.2.0",
  "description": "See which task is using your browser and desktop, and for how long.",
  "minimum_chrome_version": "120",
  "permissions": [
    "nativeMessaging",
    "alarms",
    "storage"
  ],
  "background": {
    "service_worker": "service-worker.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "Web Computer Use \u2014 connecting",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/idle-16.png",
      "32": "icons/idle-32.png"
    }
  },
  "icons": {
    "16": "icons/robot-16.png",
    "48": "icons/robot-48.png",
    "128": "icons/robot-128.png"
  },
  "key": ""
}
